# Optional. The dashboard is a loopback Mac console. A container does not
# have the host SSH agent or ControlMaster sockets unless you arrange that
# yourself. Prefer the launchd plist. This image still refuses to bind
# 0.0.0.0; publish it with host networking if you run it at all.
FROM python:3.12-slim

WORKDIR /app
COPY src /app/src
ENV PYTHONPATH=/app/src
EXPOSE 18081
CMD ["python3", "-m", "gpu_dashboard", "--host", "127.0.0.1", "--port", "18081"]
